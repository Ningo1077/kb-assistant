# 复制为 .env 后按需修改。带注释的默认值即可零依赖跑通整条链路。

# ===== 数据层 =====
# 开发默认 SQLite（零安装）；换 PostgreSQL 只需改这一行：
# DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/kb_assistant
DATABASE_URL=sqlite:///./data/app.db

# ===== 安全 =====
# 留空 = 启动时自动生成本机随机密钥并写入 data/secret.key（该文件不会入库）。
# 部署到多机/多进程时，务必在这里显式填一个足够长的随机字符串，保证各实例一致。
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# 逗号分隔的允许来源；默认已覆盖 Vite 开发服务器与 Tauri 桌面端，一般不用改。
# 若把后端暴露到局域网，请改成实际前端地址，不要填 *。
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# ===== 向量化 =====
# hashing: 无需模型，离线可用（开发默认，512 维）
# ollama : 本地 Ollama 的 bge-m3（1024 维，效果最好）
# openai : 任何 OpenAI 兼容的 embedding 接口
EMBED_PROVIDER=hashing
EMBED_DIM=512
EMBED_MODEL=bge-m3

# ===== 大模型 =====
# mock: 模板回答，无需模型，用来先把链路跑通
# ollama / openai: 真实回答
LLM_PROVIDER=mock
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# ===== 切换到 Ollama 的真实示例 =====
# EMBED_PROVIDER=ollama
# EMBED_DIM=1024              # bge-m3 是 1024 维，改 provider 必须同步改这里
# EMBED_MODEL=bge-m3
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://127.0.0.1:11434
#
# 切完必须：① 重启后端（settings / get_embedder 有 lru_cache）
#          ② 运行 scripts/reindex_all.py 重建全部文档索引
# 512 维哈希向量与 1024 维语义向量混用会让 SQLite 检索直接报形状不匹配。

# ===== 检索与分块 =====
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=5
RETRIEVE_RECALL_K=20
MAX_CONTEXT_CHARS=6000

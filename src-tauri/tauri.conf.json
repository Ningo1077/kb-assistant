{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KB-Assistant",
  "version": "1.0.0",
  "identifier": "io.github.ningo1077.kbassistant",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../frontend && npm run build:desktop",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI 知识库问答助手",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/app": "backend/app/",
      "../backend/requirements.txt": "backend/requirements.txt",
      "../backend/.env.example": "backend/.env.example",
      "../backend/scripts": "backend/scripts/",
      "../backend/.venv": "backend/.venv/",
      "windows/uninstall-cleanup.ps1": "uninstall-cleanup.ps1"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}

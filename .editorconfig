# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{ts,tsx,js,jsx,json,yml,yaml,css,html}]
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
# Markdown 的行尾空格有意义（硬换行），不裁剪
trim_trailing_whitespace = false

[*.{bat,cmd,ps1,nsi,nsh}]
end_of_line = crlf

[Makefile]
indent_style = tab

[docs/word/*.docx]
# python-docx 生成物，无需编辑
insert_final_newline = false
